        "vscode-kubernetes.helm-path-linux": "/home/asitha/.local/state/vs-kubernetes/tools/helm/linux-amd64/helm",
        "vscode-kubernetes.kubectl-path-linux": "/home/asitha/.local/state/vs-kubernetes/tools/kubectl/kubectl",
