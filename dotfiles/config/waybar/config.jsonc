// -*- mode: jsonc -*-
{
  "layer": "top",
  "position": "top",
  // "margin-bottom": 1, // way bar marging to desktop
  "spacing": 4,

  // Module Order
  "modules-left": [
    "hyprland/workspaces",
    "custom/pacman",
    "custom/media",
    "custom/wasi",
  ],
  "modules-center": ["clock"],
  "modules-right": [
    "pulseaudio",
    "bluetooth",
    "cpu",
    "memory",
    "network",
    "battery",
    "custom/power",
  ],

  // --- Modules Configuration ---

  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "sort-by-number": true,
    "show-special": false,
    "ignore-workspaces": [
      "^(?![0-9]+$).+"
    ],
    "persistent-workspaces": {
      "*": 4
    },
    "tooltip": false,
    "format": "{name}",
  },

  // media icon on way bar
  "custom/media": {
    "format": "{icon} {text}",
    "escape": true,
    "return-type": "json",
    "max-length": 30, // Fixed: Added a number here
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl stop",
    "smooth-scrolling-threshold": 10,
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous",
    "exec": "$HOME/.config/waybar/mediaplayer.py 2> /dev/null",
    "format-icons": {
      "spotify": "",
      "default": "♫"
    },
  },

  //update icon in way bar
  "custom/pacman": {
    "format": "{text} ",
    "interval": 3600,
    "exec": "$HOME/.config/waybar/check_updates.sh",
    "exec-if": "exit 0",
    "on-click": "kitty --hold bash -c 'yay -Syu && rm /tmp/waybar_pacman_updates && pkill -RTMIN+8 waybar'",
    "signal": 8,
  },

  "clock": {
    "format": "  {:%I:%M %p}", // e.g., 08:38 PM
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
  },

  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": " 󰝟 Muted",
    "format-icons": {
      "headphone": "",
      "default": ["", "", ""],
    },
    "on-click": "pavucontrol",
  },

  "network": {
    "interval": 1,
    "format-wifi": "  {essid:.5} |  󰁅 {bandwidthDownBytes}  󰁝 {bandwidthUpBytes}",
    "format-ethernet": "󰈀   Wired  |  󰁅 {bandwidthDownBytes}  󰁝 {bandwidthUpBytes}",
    "format-disconnected": "⚠  Disconnected",
    "tooltip-format": "{ifname} via {gwaddr}",
    // This launches nmtui in a floating kitty window
    "on-click": "nmcli device wifi rescan & kitty --class floating_nmtui -e nmtui",
    "on-click-right": "nm-connection-editor",
  },

  "cpu": {
    "interval": 2,
    "format": "CPU {usage}%",
    "tooltip": true,
    "tooltip-format": "CPU Usage: {usage}%",
  },

  "memory": {
    "interval": 2,
    "format": "RAM {}% | {used:0.1f}GB/{total:0.1f}GB",
    "tooltip": true,
    "tooltip-format": "RAM: {used:0.1f}GB / {total:0.1f}GB",
  },

  "battery": {
    "states": {
      "warning": 30,
      "critical": 15,
    },
    "format": "{icon}  {capacity}%",
    "format-charging": "  {capacity}%",
    "format-plugged": "  {capacity}%",
    "format-icons": ["", "", "", "", ""],
  },

  "custom/power": {
    "format": "Power",
    "tooltip": false,
    "on-click": "wlogout",
  },

  "bluetooth": {
    "format": " {status}",
    "format-connected": " {num_connections} connected",
    "tooltip-format": "{controller_alias}\t{controller_address}",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",

    // The updated click commands:
    "on-click": "bluetoothctl power on && bluetoothctl --timeout 15 scan on & blueman-manager",
    "on-click-right": "rfkill toggle bluetooth",
  },

  "custom/wasi": {
    "format": "",
    "tooltip": true,
    "tooltip-format": "WhatsApp (WASI)",
    "on-click": "wasi",
    "on-click-right": "pkill wasi",
    "exec": "pgrep -x wasi > /dev/null && echo '{\"class\": \"running\"}' || echo '{\"class\": \"stopped\"}'",
    "return-type": "json",
    "interval": 2,
  },
}
